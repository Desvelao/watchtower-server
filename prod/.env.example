POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=monitor

# ===== AUTH =====
# Generate a real random secret for production - e.g. `openssl rand -hex 32`.
JWT_SECRET=
# First admin account, bootstrapped idempotently on server boot. Leave
# both unset once you've created your own admin user through the UI.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# ===== WORKER =====
# Set to 1 to run the scrape worker inside the server process (ngx.timer)
# instead of/alongside a standalone worker deployment.
USE_EMBED_WORKER=0
WORKER_CONFIG_FILE=
