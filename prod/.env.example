POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=monitor

# ===== AUTH =====
# Generate a real random secret for production - e.g. `openssl rand -hex 32`.
JWT_SECRET=
# First admin account, bootstrapped idempotently on server boot. Leave
# both unset once you've created your own admin user through the UI.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# ===== WORKER =====
# Enabled by default: runs the observe worker inside the server process
# (ngx.timer). Set to 0 to disable it (e.g. to run only a standalone
# worker deployment instead).
USE_EMBED_WORKER=1
# Enabled by default: also runs the "scheduler" role's tick inside the
# server process - independent of USE_EMBED_WORKER (no effect unless
# that's 1 too). Set to 0 to disable just the scheduler tick.
USE_EMBED_SCHEDULER=1
# Enabled by default: also runs the "deliver" role's tick inside the
# server process - independent of USE_EMBED_WORKER (no effect unless
# that's 1 too). Set to 0 to disable just the deliver tick.
USE_EMBED_DELIVER=1
# Enabled by default: also runs the "evaluator" role's
# tick inside the server process - independent of USE_EMBED_WORKER/
# USE_EMBED_DELIVER (no effect unless USE_EMBED_WORKER is 1 too). Set to 0
# to disable just the evaluator tick.
USE_EMBED_EVALUATOR=1
WORKER_CONFIG_FILE=
# Host directory bind-mounted to /worker_plugins (see docker-compose.yml) for
# third-party worker plugin modules referenced by WORKER_CONFIG_FILE's
# `plugins` field but not already baked into the image. Leave the default -
# an empty ./worker_plugins directory is fine, and required by nothing
# unless plugins names something there.
WORKER_PLUGINS_DIR=./worker_plugins

# ===== STANDALONE WORKER (optional) =====
# Only used if you uncomment the `worker` service in docker-compose.yml -
# WORKER_PLUGINS_DIR/WORKER_CONFIG_FILE/SMTP_* above already apply to it too.
# A real API key created via POST /api/auth/api_key for a user/role with
# the permissions the worker's config.roles needs - see
# docs/dev/worker-configuration.md. SERVER_API_KEY_FILE (a Docker secret)
# is also supported in place of this.
SERVER_API_KEY=
# Host directory bind-mounted to /etc/watchtower, where
# WORKER_CONFIG_FILE (worker_config.lua) is expected to live.
WORKER_CONFIG_DIR=./worker_config

# ===== SMTP (email notifications) =====
# A single app-wide relay shared by every "email" notification channel -
# see docs/dev/worker-configuration.md's "SMTP (email notifications)"
# section. This compose file's embedded worker sends via
# server/lib/resty_mail_notifier.lua (lua-resty-mail) - no standalone
# worker is required for email to work. Prefer SMTP_PASSWORD_FILE (a
# Docker secret) over SMTP_PASSWORD in production. Only implicit TLS is
# supported (SMTP_SSL=1, typically port 465) - not STARTTLS/port 587.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=1
