POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=monitor

# ===== AUTH =====
JWT_SECRET=supersecretjwt
# First admin account, bootstrapped idempotently on server boot.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=adminpass

# ===== WORKER =====
# Set to 1 to run the scrape worker inside the server process (ngx.timer).
USE_EMBED_WORKER=0
WORKER_CONFIG_FILE=/etc/price-monitor/outputs/worker_config.lua
# Server API key for the standalone worker (see docs/dev/worker-configuration.md).
SERVER_API_KEY=
