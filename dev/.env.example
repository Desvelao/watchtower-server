POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=monitor

# ===== AUTH =====
JWT_SECRET=supersecretjwt
# First admin account, bootstrapped idempotently on server boot.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=adminpass

# ===== WORKER =====
# Enabled by default: runs the observe worker inside the server process
# (ngx.timer). Set to 0 to disable it.
USE_EMBED_WORKER=1
# Enabled by default: also runs the "scheduler" role's tick inside the
# server process - independent of USE_EMBED_WORKER (no effect unless
# that's 1 too). Set to 0 to disable just the scheduler tick.
USE_EMBED_SCHEDULER=1
# Enabled by default: also runs the "deliver" role's tick inside the
# server process - independent of USE_EMBED_WORKER (no effect unless
# that's 1 too). Set to 0 to disable just the deliver tick.
USE_EMBED_DELIVER=1
# Enabled by default: also runs the "evaluator" role's
# tick inside the server process - independent of USE_EMBED_WORKER/
# USE_EMBED_DELIVER (no effect unless USE_EMBED_WORKER is 1 too). Set to 0
# to disable just the evaluator tick.
USE_EMBED_EVALUATOR=1
WORKER_CONFIG_FILE=/etc/watchtower/worker_config.lua
# Server API key for the standalone worker (see docs/dev/worker-configuration.md).
SERVER_API_KEY=

# ===== SMTP (email notifications) =====
# A single app-wide relay shared by every "email" notification channel -
# see docs/dev/worker-configuration.md's "SMTP (email notifications)"
# section. Both the embedded worker (lapis service, via
# server/lib/resty_mail_notifier.lua/lua-resty-mail) and the standalone
# worker below (via pling.notifiers.email) can actually send. Only
# implicit TLS is supported (SMTP_SSL=1, typically port 465) - not
# STARTTLS/port 587. For Gmail: enable 2-Step Verification on the account,
# generate an App Password (myaccount.google.com > Security > App
# passwords), and use SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=<gmail address>, SMTP_PASSWORD=<16-char app password>,
# SMTP_FROM=<gmail address>.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=1
